{
  "name": "lnpm-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "LNPM Cloud Dashboard — Nuxt 4 + Nitro backend with SQLite, WebSocket, and live dashboard",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "nuxt typecheck",
    "typecheck:watch": "nuxt typecheck --watch"
  },
  "dependencies": {
    "@nuxt/nitro-server": "^4.5.1",
    "better-sqlite3": "^11.10.0",
    "nuxt": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.4.1"
}
