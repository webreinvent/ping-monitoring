# LNPM Cloud Dashboard — Environment Configuration
# Copy this file to .env and adjust values as needed.
# See requirements/README.md for full documentation.

# Environment mode
NODE_ENV=development

# HTTP server port
PORT=3000

# SQLite database path (relative to project root)
DATABASE_PATH=.data/lingering.db

# Logging verbosity (debug | info | warn | error)
LOG_LEVEL=debug

# ------------------------------------------------------------------
# WebSocket configuration
# ------------------------------------------------------------------

# WebSocket ping/pong heartbeat interval (milliseconds)
WS_HEARTBEAT_INTERVAL_MS=30000

# Maximum concurrent WebSocket connections
WS_MAX_CLIENTS=1000

# ------------------------------------------------------------------
# Ingest configuration
# ------------------------------------------------------------------

# Maximum samples per batch POST request
INGEST_MAX_SAMPLES=1000

# Maximum allowed future timestamp offset (milliseconds) — rejects samples >5 min in the future
INGEST_FUTURE_WINDOW_MS=300000

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------

# Rate limit time window (milliseconds)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window per IP (1000 for dev, 100 for prod)
RATE_LIMIT_MAX_REQUESTS=1000

# ------------------------------------------------------------------
# Data retention
# ------------------------------------------------------------------

# How long to keep raw ping samples (days)
RETENTION_DAYS=30

# How long to keep minute rollups (days)
ROLLUP_RETENTION_DAYS=90

# Days of inactivity before a monitor is considered inactive
MONITOR_INACTIVE_DAYS=30

# ------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------

# Maximum entries in the in-memory LRU cache
LRU_CACHE_MAX=10000
